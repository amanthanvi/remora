deployment_profile = "self_hosted"

[server]
bind = "0.0.0.0:8787"

[database]
kind = "postgres"
url_env = "REMORA_RELAY_DATABASE_URL"
max_connections = 20

[security]
token_key_path = "/run/secrets/remora-relay-token-key"
bootstrap_token_file = "/run/secrets/remora-relay-bootstrap-token"

[push]
mode = "disabled"

[worker]
batch_size = 64
poll_interval_ms = 500
maintenance_interval_ms = 60000
