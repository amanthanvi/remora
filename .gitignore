# macOS
.DS_Store

# Build system stamps
.build-stamps/

# Xcode user/workspace state
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/

# Build outputs
.build/
build/
DerivedData/
apps/android/.gradle/
apps/ios/Frameworks/
apps/ios/GeneratedRust/
apps/ios/Resources/fs/
apps/ios/Remora.xcodeproj/Remora.xcodeproj/

# SwiftPM
Packages/

# Rust
**/target/

# Generated code (codegen + UniFFI — regenerate with build-rust.sh)
*.generated.rs
*.generated.swift
shared/rust-bridge/generated/

# Android JNI outputs (generated from Rust bridge)
apps/android/core/bridge/src/main/jniLibs/*/*.so
apps/android/core/bridge/.cxx/
apps/android/core/bridge/src/main/cpp/include/ghostty.h

# Android bundled native artifacts generated by build scripts
apps/android/app/src/main/jniLibs/*/*.so

# Kotlin compiler cache
apps/android/.kotlin/

# Logs and temp
*.log
*.tmp
tmp/
__pycache__/

# Local screenshots
Simulator Screenshot*.png

# IDE and Android Environment Defaults
.idea/
*.iml
local.properties
apps/android/.idea/
apps/android/build/
apps/android/app/build/
apps/android/core/*/build/
apps/android/feature/*/build/

# Local schema snapshots
docs/codex-schema/
apps/android/kls_database.db
node_modules/

# Local env (credentials)
.env
.envrc
.local/

# Local agent/orchestration state (never committed)
.intent/
.orchestration/

# Factory/Droid
.factory/
.claude/
shared/third_party/codex/
.wrangler/
artifacts/
.xcodebuildmcp/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/remora-improve/
!.agents/skills/remora-improve/**
!.agents/skills/remora-ponytail/
!.agents/skills/remora-ponytail/**
!.agents/skills/PROVENANCE.md
!.agents/vendor-skills/
.agents/vendor-skills/*
!.agents/vendor-skills/improve/
!.agents/vendor-skills/improve/**
!.agents/vendor-skills/ponytail/
!.agents/vendor-skills/ponytail/**
.antigravitycli/
skills-lock.json
