{
  "name": "Remora Light",
  "type": "light",
  "colors": {
    "activityBar.activeBorder": "#036F8F",
    "activityBar.background": "#DCEFF5",
    "activityBar.foreground": "#365866",
    "activityBarBadge.background": "#036F8F",
    "activityBarBadge.foreground": "#FFFFFF",
    "button.background": "#036F8F",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#005A75",
    "editor.background": "#F7FCFE",
    "editor.foreground": "#102A36",
    "editor.lineHighlightBackground": "#EAF7FB",
    "editor.selectionBackground": "#0DD5F033",
    "editorCursor.foreground": "#036F8F",
    "editorGroup.border": "#B7DCE7",
    "editorGroupHeader.tabsBackground": "#EAF7FB",
    "editorLineNumber.foreground": "#4E6671",
    "editorLineNumber.activeForeground": "#036F8F",
    "panel.background": "#EAF7FB",
    "panel.border": "#D8E8F1",
    "sideBar.background": "#EAF7FB",
    "sideBar.foreground": "#365866",
    "sideBar.border": "#B7DCE7",
    "sideBarTitle.foreground": "#102A36",
    "statusBar.background": "#F7FCFE",
    "statusBar.foreground": "#036F8F",
    "textLink.foreground": "#036F8F",
    "gitDecoration.addedResourceForeground": "#2E7D32",
    "gitDecoration.deletedResourceForeground": "#D32F2F"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#4E6671" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#036F8F" }
    },
    {
      "scope": ["constant.numeric", "constant.language.boolean"],
      "settings": { "foreground": "#005A75" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#036F8F" }
    },
    {
      "scope": ["entity.name.type", "entity.other.inherited-class", "support.class", "support.type"],
      "settings": { "foreground": "#145E73" }
    },
    {
      "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call"],
      "settings": { "foreground": "#102A36" }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#2A4A5F" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#4E6671" }
    }
  ]
}
