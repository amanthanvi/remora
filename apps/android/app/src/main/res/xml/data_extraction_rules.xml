<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Remora Link v2's journal and encrypted transport identity are stored under
         noBackupFilesDir, which Android excludes from cloud and device transfer. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="remora_push_awareness_v1.xml" />
        <exclude domain="sharedpref" path="alleycat_credentials.xml" />
        <exclude domain="file" path="remora_link_credentials_v2/" />
        <exclude domain="sharedpref" path="remora_chatgpt_auth.xml" />
        <exclude domain="sharedpref" path="remora_openai_api_key.xml" />
        <exclude domain="sharedpref" path="remora_ssh_credentials.xml" />
        <exclude domain="sharedpref" path="remora_ssh_trust.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="remora_push_awareness_v1.xml" />
        <exclude domain="sharedpref" path="alleycat_credentials.xml" />
        <exclude domain="file" path="remora_link_credentials_v2/" />
        <exclude domain="sharedpref" path="remora_chatgpt_auth.xml" />
        <exclude domain="sharedpref" path="remora_openai_api_key.xml" />
        <exclude domain="sharedpref" path="remora_ssh_credentials.xml" />
        <exclude domain="sharedpref" path="remora_ssh_trust.xml" />
    </device-transfer>
</data-extraction-rules>
