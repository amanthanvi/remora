+fn allowed_hosts_for(bind_addr: SocketAddr) -> Vec<String> {
+    let mut allowed = vec![bind_addr.to_string()];
+    if bind_addr.ip().is_loopback() || bind_addr.ip().is_unspecified() {
+        for host in ["localhost", "127.0.0.1", "[::1]"] {
+            allowed.push(format!("{host}:{}", bind_addr.port()));
+        }
+    }
+    if bind_addr.port() == 80 {
+        let default_authorities = allowed
+            .iter()
+            .filter_map(|authority| authority.strip_suffix(":80").map(str::to_owned))
+            .collect::<Vec<_>>();
+        allowed.extend(default_authorities);
+    }
+    allowed
+}
+
+fn host_is_allowed(headers: &HeaderMap, allowed: &[String]) -> bool {
+    let mut hosts = headers.get_all(HOST).iter();
+    let Some(host) = hosts.next().and_then(|value| value.to_str().ok()) else {
+        return false;
+    };
+    hosts.next().is_none() && allowed.iter().any(|value| value.eq_ignore_ascii_case(host))
+}
+
+async fn require_allowed_host(
+    State(allowed): State<Arc<Vec<String>>>,
+    request: Request<Body>,
+    next: Next,
+) -> Result<Response, StatusCode> {
+    if host_is_allowed(request.headers(), &allowed) {
+        Ok(next.run(request).await)
+    } else {
+        Err(StatusCode::FORBIDDEN)
+    }
 }
 
