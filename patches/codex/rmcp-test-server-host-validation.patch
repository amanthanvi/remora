+#[cfg(test)]
+mod tests {
+    use super::*;
+    use axum::http::HeaderValue;
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+    use tokio::net::TcpListener;
+    use tokio::net::TcpStream;
+
+    #[test]
+    fn host_allowlist_requires_single_exact_authority() {
+        let allowed = allowed_hosts_for("127.0.0.1:3920".parse().unwrap());
+        for host in [
+            "127.0.0.1:3920",
+            "localhost:3920",
+            "LOCALHOST:3920",
+            "[::1]:3920",
+        ] {
+            let mut headers = HeaderMap::new();
+            headers.insert(HOST, HeaderValue::from_str(host).unwrap());
+            assert!(host_is_allowed(&headers, &allowed), "{host}");
+        }
+        for host in [
+            "attacker.example:3920",
+            "localhost.attacker.example:3920",
+            "localhost",
+            "localhost:3921",
+            "127.0.0.1:03920",
+            "localhost:3920@attacker.example",
+            "localhost:3920,attacker.example:3920",
+            "[::1]",
+        ] {
+            let mut headers = HeaderMap::new();
+            headers.insert(HOST, HeaderValue::from_str(host).unwrap());
+            assert!(!host_is_allowed(&headers, &allowed), "{host}");
+        }
+        let mut headers = HeaderMap::new();
+        assert!(!host_is_allowed(&headers, &allowed));
+        headers.append(HOST, HeaderValue::from_static("localhost:3920"));
+        headers.append(HOST, HeaderValue::from_static("localhost:3920"));
+        assert!(!host_is_allowed(&headers, &allowed));
+
+        let private = allowed_hosts_for("192.0.2.10:3920".parse().unwrap());
+        assert_eq!(private, ["192.0.2.10:3920"]);
+        let ipv6 = allowed_hosts_for("[::1]:3920".parse().unwrap());
+        assert!(ipv6.contains(&"[::1]:3920".to_string()));
+        let wildcard = allowed_hosts_for("0.0.0.0:3920".parse().unwrap());
+        assert!(wildcard.contains(&"localhost:3920".to_string()));
+        assert!(!wildcard.contains(&"192.0.2.10:3920".to_string()));
+    }
+
+    #[test]
+    fn default_http_port_allows_only_matching_bare_authorities() {
+        for bind in ["127.0.0.1:80", "[::1]:80", "0.0.0.0:80"] {
+            let allowed = allowed_hosts_for(bind.parse().unwrap());
+            for host in ["localhost", "127.0.0.1", "[::1]", "localhost:80"] {
+                let mut headers = HeaderMap::new();
+                headers.insert(HOST, HeaderValue::from_str(host).unwrap());
+                assert!(host_is_allowed(&headers, &allowed), "{bind}: {host}");
+            }
+            for host in [
+                "attacker.example",
+                "localhost.attacker.example",
+                "localhost:81",
+                "localhost:080",
+            ] {
+                let mut headers = HeaderMap::new();
+                headers.insert(HOST, HeaderValue::from_str(host).unwrap());
+                assert!(!host_is_allowed(&headers, &allowed), "{bind}: {host}");
+            }
+        }
+        assert_eq!(
+            allowed_hosts_for("192.0.2.10:80".parse().unwrap()),
+            ["192.0.2.10:80", "192.0.2.10"]
+        );
+        assert_eq!(
+            allowed_hosts_for("[2001:db8::1]:80".parse().unwrap()),
+            ["[2001:db8::1]:80", "[2001:db8::1]"]
+        );
+    }
+
+    async fn request_status(
+        address: SocketAddr,
+        method: &str,
+        path: &str,
+        host: Option<&str>,
+        body: &str,
+    ) -> u16 {
+        let mut stream = TcpStream::connect(address).await.unwrap();
+        let host_header = host
+            .map(|host| format!("Host: {host}\r\n"))
+            .unwrap_or_default();
+        let request = format!(
+            "{method} {path} HTTP/1.1\r\n{host_header}Connection: close\r\nContent-Type: application/json\r\nContent-Length: {}\r\n\r\n{body}",
+            body.len()
+        );
+        stream.write_all(request.as_bytes()).await.unwrap();
+        let mut response = Vec::new();
+        tokio::time::timeout(Duration::from_secs(5), stream.read_to_end(&mut response))
+            .await
+            .unwrap()
+            .unwrap();
+        String::from_utf8(response)
+            .unwrap()
+            .split_whitespace()
+            .nth(1)
+            .unwrap()
+            .parse()
+            .unwrap()
+    }
+
+    #[tokio::test]
+    async fn host_gate_covers_mcp_control_and_metadata_routes() {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let router = test_server_router(address, None);
+        let server = tokio::spawn(async move { axum::serve(listener, router).await.unwrap() });
+        let allowed = format!("localhost:{}", address.port());
+        let foreign = format!("attacker.example:{}", address.port());
+        let body = r#"{"status":503,"remaining":1}"#;
+        for (method, path, body) in [
+            ("POST", "/mcp", "{}"),
+            ("POST", SESSION_POST_FAILURE_CONTROL_PATH, body),
+            ("GET", "/.well-known/oauth-authorization-server/mcp", ""),
+        ] {
+            assert_eq!(
+                request_status(address, method, path, Some(&foreign), body).await,
+                403
+            );
+            // HTTP parsers may reject a missing HTTP/1.1 Host before middleware.
+            assert!(matches!(
+                request_status(address, method, path, None, body).await,
+                400 | 403
+            ));
+        }
+        assert_eq!(
+            request_status(
+                address,
+                "GET",
+                "/.well-known/oauth-authorization-server/mcp",
+                Some(&allowed),
+                ""
+            )
+            .await,
+            200
+        );
+        assert_eq!(
+            request_status(
+                address,
+                "POST",
+                SESSION_POST_FAILURE_CONTROL_PATH,
+                Some(&address.to_string()),
+                body
+            )
+            .await,
+            204
+        );
+        server.abort();
+    }
+}
